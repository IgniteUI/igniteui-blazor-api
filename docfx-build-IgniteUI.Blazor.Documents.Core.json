{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/IgniteUI.Blazor.Documents.Core.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "template": ["api-templates"],
    "globalMetadata": {
      "_assemblyName": "IgniteUI.Blazor.Documents.Core"
    },
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/toc.yml"
        ]
      }
    ],
    "rawModelOutputFolder": "api-raw",
    "dest": "api-json"
  }
}